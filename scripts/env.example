# AI Gündem — ortam değişkeni şablonu. Gerçek değerler repo kökündeki .env'de (git'e girmez).
# Doldurmak için:  npm run setup:env   (scripts/setup-env.ps1)
#
# KURAL: EXPO_PUBLIC_ önekli her değişken uygulama paketine gömülür ve herkese
# açıktır. API anahtarlarına bu öneki verme; model çağrıları sunucu tarafında
# (Supabase Edge Function) yapılır.

# --- Özet sağlayıcısı (P11, addendum §H) ------------------------------------
# Üç sağlayıcıdan biri özetleri üretir. Üçü de AYNI istemi, AYNI doğrulayıcıyı ve
# AYNI hata kodlarını kullanır; değişen yalnızca hangisinin cevap verdiğidir.
#
# ÖNEMLİ: buradaki anahtarların hiçbiri EXPO_PUBLIC_ öneki ALMAZ — o önek
# uygulama paketine gömülür ve herkese açık olur. Bu değişkenler yalnızca
# sunucu tarafında (Edge Function) okunur.
#
# CANLI KURULUMDA BUNLARIN HİÇBİRİNE GEREK YOK: Gemini ve NVIDIA anahtarları
# Supabase Vault'ta (aigundem_gemini_api_key, aigundem_nvidia_api_key) duruyor ve
# fonksiyon onları oradan okuyor. Aşağıdakiler yalnızca yerel/geçici bir
# geçersiz kılma yoludur; ortam değişkeni Vault'a göre önceliklidir.

# Hangi sağlayıcı: gemini | nvidia | anthropic | auto  (varsayılan: auto)
# auto = anahtarı çözülen ilk sağlayıcı, şu sırayla: gemini -> nvidia -> anthropic
AI_PROVIDER=auto

# Google AI Studio anahtarı (isteğe bağlı; normalde Vault'tan gelir)
GEMINI_API_KEY=

# Gemini modeli (varsayılan gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini "düşünme" bütçesi. 0 = kapalı (varsayılan; üç maddelik özet için
# gereksiz maliyet). Negatif = alanı hiç gönderme.
GEMINI_THINKING_BUDGET=0

# NVIDIA NIM anahtarı (isteğe bağlı; normalde Vault'tan gelir)
NVIDIA_API_KEY=

# NVIDIA modeli (varsayılan meta/llama-3.3-70b-instruct)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Claude — bu projede anahtar YOK ve gelmeyecek. Yalnızca ortam değişkeninden
# okunur (Vault'a konmaz), bu yüzden pratikte boş kalır.
ANTHROPIC_API_KEY=

# Kullanılacak Claude modeli (varsayılan claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Günlük küresel özet çağrısı tavanı (varsayılan 200). 0 = tamamen kapalı.
AI_DAILY_CAP=200

# İsteğe bağlı: EAS build/submit ve CI için. expo.dev → Account → Access tokens
EXPO_TOKEN=

# --- Veri kaynağı (P1 seam) -------------------------------------------------
# Aşağıdaki üç değişken TASARIM GEREĞİ herkese açıktır: Supabase proje URL'si ve
# anon anahtarı istemciye gömülmek üzere yapılmıştır; koruma RLS ile sağlanır.
# Gizli olan hiçbir şey (service_role, ANTHROPIC_API_KEY) EXPO_PUBLIC_ almaz.

# Hangi veri kaynağı kullanılsın: mock | supabase  (varsayılan: mock)
# mock     = src/data/*.ts içindeki prototip verisi (ağ yok)
# supabase = gerçek backend (P6 tamamlanana kadar çalışmaz)
EXPO_PUBLIC_DATA_MODE=mock

# Supabase proje URL'si (yalnızca DATA_MODE=supabase iken gerekli)
EXPO_PUBLIC_SUPABASE_URL=https://eglxzbsrewbleqlstefd.supabase.co

# Supabase anon JWT (yalnızca DATA_MODE=supabase iken gerekli).
# NOT: verify_jwt=true olan Edge Function'lar JWT bearer beklediği için burada
# eski (legacy) anon JWT kullanılıyor — arch-001.addendum.md §F. Aynı projenin
# yeni publishable anahtarı (sb_publishable_FR-7VBv8Y_A6q3FlFzQfug_6u7IVEdY)
# Edge auth yeniden ele alındığında bunun yerini alacak.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVnbHh6YnNyZXdibGVxbHN0ZWZkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQyOTQyNjYsImV4cCI6MjA4OTg3MDI2Nn0.2R19msD1ozv_feOH9by__Cm12BYSaz6F2hYE2q9JaEE
