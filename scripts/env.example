# AI Gündem — ortam değişkeni şablonu. Gerçek değerler repo kökündeki .env'de (git'e girmez).
# Doldurmak için:  npm run setup:env   (scripts/setup-env.ps1)
#
# KURAL: EXPO_PUBLIC_ önekli her değişken uygulama paketine gömülür ve herkese
# açıktır. API anahtarlarına bu öneki verme; Claude çağrıları sunucu tarafında
# (Expo API route / küçük bir proxy) yapılır.

# Claude özet + EN→TR çeviri (zorunlu — o özellik eklendiğinde). console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Kullanılacak model (varsayılan claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# İsteğe bağlı: EAS build/submit ve CI için. expo.dev → Account → Access tokens
EXPO_TOKEN=

# --- Veri kaynağı (P1 seam) -------------------------------------------------
# Aşağıdaki üç değişken TASARIM GEREĞİ herkese açıktır: Supabase proje URL'si ve
# anon anahtarı istemciye gömülmek üzere yapılmıştır; koruma RLS ile sağlanır.
# Gizli olan hiçbir şey (service_role, ANTHROPIC_API_KEY) EXPO_PUBLIC_ almaz.

# Hangi veri kaynağı kullanılsın: mock | supabase  (varsayılan: mock)
# mock     = src/data/*.ts içindeki prototip verisi (ağ yok)
# supabase = gerçek backend (P6 tamamlanana kadar çalışmaz)
EXPO_PUBLIC_DATA_MODE=mock

# Supabase proje URL'si (yalnızca DATA_MODE=supabase iken gerekli)
EXPO_PUBLIC_SUPABASE_URL=https://eglxzbsrewbleqlstefd.supabase.co

# Supabase anon JWT (yalnızca DATA_MODE=supabase iken gerekli).
# NOT: verify_jwt=true olan Edge Function'lar JWT bearer beklediği için burada
# eski (legacy) anon JWT kullanılıyor — arch-001.addendum.md §F. Aynı projenin
# yeni publishable anahtarı (sb_publishable_FR-7VBv8Y_A6q3FlFzQfug_6u7IVEdY)
# Edge auth yeniden ele alındığında bunun yerini alacak.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVnbHh6YnNyZXdibGVxbHN0ZWZkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQyOTQyNjYsImV4cCI6MjA4OTg3MDI2Nn0.2R19msD1ozv_feOH9by__Cm12BYSaz6F2hYE2q9JaEE
